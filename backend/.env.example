# Copy to .env and adjust. Every setting can also be passed as an environment variable.

ENVIRONMENT=development

# Local dev without Docker uses SQLite. With docker compose / production use Postgres:
# DATABASE_URL=postgresql+asyncpg://gym:gym@localhost:5432/gym_crm
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Required in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Background jobs: "inprocess" (dev, runs inside the API), "celery" (production: run
# `celery -A app.worker worker --beat` with Redis), or "off".
SCHEDULER=inprocess
REDIS_URL=redis://localhost:6379/0

# Email: "console" (prints to the server log), "smtp" or "resend".
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=reminders@yourgym.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# RESEND_API_KEY=

# true when served over HTTPS (required when ENVIRONMENT=production)
COOKIE_SECURE=false
# Proxies in front of the API that append to X-Forwarded-For (for rate limits):
# 1 = just the Next.js server, 2 = a load balancer in front of it (Render and most hosts).
TRUSTED_PROXY_HOPS=1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# File storage for progress photos: "local" (STORAGE_DIR) or "s3" (also works with R2/MinIO).
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# AI workout & diet plans (Anthropic). Leave ANTHROPIC_API_KEY unset to disable.
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MONTHLY_PLAN_LIMIT=100

# Error monitoring (Sentry). Leave unset to disable. No personal data is sent.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# RELEASE=            # e.g. the git commit
LOG_LEVEL=INFO
LOG_JSON=false        # true: one JSON object per log line
